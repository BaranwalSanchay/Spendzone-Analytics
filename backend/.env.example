# Groq LLM inference (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# Optional: override the Groq model used by every report-generation agent. Groq's model
# catalog and per-account entitlements change over time (Llama chat models like
# llama-3.3-70b-versatile have been deprecated on some accounts), so the hardcoded default
# below can occasionally 404 with "model_not_found" -- if that happens, check
# https://console.groq.com/docs/models (or your own console's Playground model dropdown,
# which reflects what your account can actually use) and set this to a model you have
# access to. openai/gpt-oss-120b (used as the default) supports both plain chat and tool
# calling, which every agent in this pipeline needs.
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (used by the sequential report generator, https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Tavily web search (used by the market analysis agent, https://app.tavily.com)
TAVILY_API_KEY=your-tavily-api-key
