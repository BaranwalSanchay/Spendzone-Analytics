# Supabase project connection (Project Settings > API in your Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Base URL of the Spendzone backend API (Spendzone-Analytics/backend), used for
# CSV schema validation and the what-if budget scenario endpoint. Optional in
# dev — the CSV uploader falls back to a client-side check if unset/unreachable.
VITE_API_BASE_URL=http://localhost:8000
